#!/bin/bash
#PBS -N qwen-smoke
#PBS -P personal-mehr0004
#PBS -q normal
#PBS -l select=1:ngpus=1:ncpus=16:mem=64gb
#PBS -l walltime=01:00:00
#PBS -j oe
#PBS -o logs/qwen_smoke.log

# Serve Qwen2-7B-Instruct with vLLM on one GPU, then run scripts/smoke_llm.py
# against it. Walltime 1h routes this to gdev (max 2h). For longer runs, push
# walltime past 2h and PBS routes to g1 instead.
#
# Weights are pre-downloaded to HF_HOME on /scratch - do NOT let the job fetch
# them, that burns GPU walltime on a network transfer.

set -u
cd "$PBS_O_WORKDIR" || exit 1

export PATH="$HOME/.pixi/bin:$PATH"
export HF_HOME=/scratch/users/ntu/mehr0004/hf-cache
export HF_HUB_OFFLINE=1          # weights are local; fail loudly rather than silently re-downloading
export VLLM_LOGGING_LEVEL=INFO

MODEL=Qwen/Qwen2-7B-Instruct
PORT=8000
SERVER_LOG="logs/vllm_${PBS_JOBID%%.*}.log"

echo "=================== node ==================="
hostname
nvidia-smi || { echo "!! no GPU visible - aborting"; exit 1; }

echo
echo "=================== CUDA_VISIBLE_DEVICES fixup ==================="
# PBS on this cluster hands out GPUs by UUID:
#   CUDA_VISIBLE_DEVICES=GPU-56a80cdd-0b02-21a0-5a11-f8b2a94b095f
# PyTorch accepts that, but vllm does int(...) on it in
# platforms/interface.py:device_id_to_physical_device_id and dies with
#   ValueError: invalid literal for int() with base 10: 'GPU-...'
# So translate UUIDs to integer indices before starting vllm.
#
# NOT just hardcoding 0: these nodes are `sharing = default_shared` with 4 GPUs,
# so index 0 may belong to somebody else's job. Map the UUID we were actually
# given to its real index.
echo "as given by PBS: ${CUDA_VISIBLE_DEVICES:-<unset>}"
if [[ "${CUDA_VISIBLE_DEVICES:-}" == GPU-* ]]; then
    mapped=""
    IFS=',' read -ra _uuids <<< "$CUDA_VISIBLE_DEVICES"
    for _u in "${_uuids[@]}"; do
        _u="$(echo "$_u" | xargs)"          # trim whitespace
        _idx=$(nvidia-smi --query-gpu=index,uuid --format=csv,noheader \
               | awk -F',' -v u="$_u" '{gsub(/ /,"",$1); gsub(/ /,"",$2)} $2==u {print $1}')
        if [ -z "$_idx" ]; then
            echo "!! could not map UUID $_u to an index"; exit 1
        fi
        mapped="${mapped:+$mapped,}$_idx"
    done
    export CUDA_VISIBLE_DEVICES="$mapped"
fi
echo "using          : ${CUDA_VISIBLE_DEVICES:-<unset>}"

echo
echo "=================== torch sees ==================="
# Confirms the cu128 build actually matches this node's driver before we spend
# five minutes loading 15GB of weights only to fail.
pixi run -e serve python - <<'PY' || exit 1
import sys, torch
print("torch      :", torch.__version__)
print("built CUDA :", torch.version.cuda)
print("available  :", torch.cuda.is_available())
if not torch.cuda.is_available():
    print("!! CUDA unavailable - the torch build does not match this driver.")
    sys.exit(1)
print("device     :", torch.cuda.get_device_name(0))
free, total = torch.cuda.mem_get_info()
print(f"VRAM       : {free/1e9:.1f} GB free / {total/1e9:.1f} GB total")
PY

echo
echo "=================== starting vLLM ==================="
pixi run -e serve vllm serve "$MODEL" \
    --port "$PORT" \
    --max-model-len 8192 \
    --gpu-memory-utilization 0.90 \
    > "$SERVER_LOG" 2>&1 &
SERVER_PID=$!

# Always reap the server, whatever happens after this point - a stranded vLLM
# holds the GPU for the rest of the walltime and burns SU for nothing.
cleanup() {
    echo "--- shutting down vLLM (pid $SERVER_PID) ---"
    kill "$SERVER_PID" 2>/dev/null
    wait "$SERVER_PID" 2>/dev/null
}
trap cleanup EXIT INT TERM

echo "vLLM pid $SERVER_PID, log -> $SERVER_LOG"
echo "waiting for /health (loading ~15GB of weights, expect several minutes)..."

# Poll rather than sleep: a fixed sleep either wastes walltime or fires early.
# Also bail out early if the server process dies, instead of waiting the full
# timeout for a health check that can never succeed.
DEADLINE=$((SECONDS + 900))
until curl -sf "http://localhost:${PORT}/health" > /dev/null 2>&1; do
    if ! kill -0 "$SERVER_PID" 2>/dev/null; then
        echo "!! vLLM died during startup. Last 40 lines:"
        tail -40 "$SERVER_LOG"
        exit 1
    fi
    if [ "$SECONDS" -ge "$DEADLINE" ]; then
        echo "!! timed out after 900s waiting for /health. Last 40 lines:"
        tail -40 "$SERVER_LOG"
        exit 1
    fi
    sleep 5
done
echo "server is up after ${SECONDS}s"

echo
echo "=================== smoke test ==================="
export KGLAMP_LLM_BASE_URL="http://localhost:${PORT}/v1"
export KGLAMP_MODEL="$MODEL"
pixi run -e serve python scripts/smoke_llm.py
RC=$?

echo
echo "=================== done (exit $RC) ==================="
echo "vLLM server log: $SERVER_LOG"
exit $RC
