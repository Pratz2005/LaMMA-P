# SECRET - never commit. The pipeline uses a local vLLM server and needs no key.
api_key.txt
*.key

# pixi environments live outside the repo (detached-environments); .pixi/envs is
# a symlink to /scratch on NSCC and would be machine-specific anywhere.
.pixi/

__pycache__/
*.pyc

# Run outputs. Regenerated by scripts/run_kg_task.py; the evidence you want to
# keep is copied into demo/ instead.
logs/
resources/kglamp_problems/
sas_plan
*.plan
!demo/*.plan
!runs/**/*.plan

# Fast Downward build artifacts - must be compiled on each machine
downward/builds/
